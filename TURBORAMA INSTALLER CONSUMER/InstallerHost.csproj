<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <IncludePrerequisitePayloads Condition="'$(IncludePrerequisitePayloads)' == ''">true</IncludePrerequisitePayloads>
    <OutputType>WinExe</OutputType>
    <!-- A payload-free validation build is a DLL, never a distributable installer. -->
    <OutputType Condition="'$(IncludePrerequisitePayloads)' != 'true'">Library</OutputType>
    <RootNamespace>InstallerHost</RootNamespace><AssemblyName>InstallerHost</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <!-- The offline bundle exceeds the address-space budget of a 32-bit CLR.
         Host x64 still installs both x86 and x64 game dependencies. -->
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\$(Configuration)\</OutputPath><WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <ApplicationManifest Condition="'$(IncludePrerequisitePayloads)' == 'true'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(IncludePrerequisitePayloads)' == 'true'">resources\Builder.ico</ApplicationIcon>
    <StartupObject Condition="'$(IncludePrerequisitePayloads)' == 'true'">InstallerHost.Program</StartupObject>
  </PropertyGroup>
