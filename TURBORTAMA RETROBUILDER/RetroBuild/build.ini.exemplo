[BuilderOptions]
retrobat_version=6.0
retroarch_version=1.20.0
branch=stable
architecture=win64

get_batgui=1
get_batocera_ports=1
get_bios=1
get_decorations=1
get_default_theme=1
get_emulationstation=1
get_emulators=1
get_lrcores=1
get_retroarch=1
get_retrobat_binaries=1
get_system=1
get_wiimotegun=0

7za_path=system\tools\7za.exe
wget_path=system\tools\wget.exe
curl_path=system\tools\curl.exe

retrobat_ftp=http://www.retrobat.ovh/repo/
retrobat_binaries_url=https://github.com/luziellacerda/TurboramaBinarios/releases/download/

emulationstation_url=https://github.com/luziellacerda/TurboramaEmulationStation/releases/download/continuous-master/
emulatorlauncher_url=https://github.com/RetroBat-Official/emulatorlauncher/releases/download/continuous/
bios_git_url=https://github.com/RetroBat-Official/retrobat-bios
theme_path=https://github.com/luziellacerda/PC-RETRO-LZ-THEME-PC-NEW
decorations_path=https://github.com/RetroBat-Official/retrobat-bezels
system_path=https://github.com/RetroBat-Official/RetroBat/tree/master/system
retroarch_url=https://buildbot.libretro.com
wiimotegun_url=
batgui_url=https://github.com/RetroBat-Official/BatGui/releases/download/continuous/BatGui.zip
