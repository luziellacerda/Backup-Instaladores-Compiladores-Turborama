<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SuiteCompatibilityTargetFramework)' == ''">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(SuiteCompatibilityTargetFramework)' != ''">$(SuiteCompatibilityTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Upstream/*.cs" />
    <Compile Include="../BridgeConnection.cs" />
    <Compile Include="../LicenseCache.cs" />
    <Compile Include="../AccessFailurePresentation.cs" />
  </ItemGroup>
</Project>
