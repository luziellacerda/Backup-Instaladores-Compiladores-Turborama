<!--
  TURBORAMA - Carrossel detalhado de jogos
  Layout 16:9 com oito capas, video em destaque e painel de informacoes.
  Esta vista e isolada e nao altera detailed, grid ou carousel.
-->
<theme>
   <formatVersion>7</formatVersion>

   <view name="gamecarousel">
      <!-- Fundo dinamico do jogo selecionado. -->
      <image name="md_fanart">
         <origin>0 0</origin>
         <pos>0 0</pos>
         <size>1 1</size>
         <opacity>0.24</opacity>
         <linearSmooth>true</linearSmooth>
         <zIndex>1</zIndex>
      </image>

      <!-- Base escura para manter contraste constante. -->
      <image name="layoutBackground" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <origin>0 0</origin>
         <pos>0 0</pos>
         <size>1 1</size>
         <color>05080EDF</color>
         <zIndex>2</zIndex>
      </image>

      <!-- Cabecalho compacto. -->
      <image name="titleAccent" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.028 0.024</pos>
         <size>0.005 0.063</size>
         <color>${genreColor}</color>
         <roundCorners>0.003</roundCorners>
         <zIndex>80</zIndex>
      </image>

      <text name="md_name">
         <pos>0.045 0.018</pos>
         <size>0.735 0.055</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.038</fontSize>
         <color>FFFFFFFF</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <singleLineScroll>true</singleLineScroll>
         <glowColor>00000080</glowColor>
         <glowSize>1</glowSize>
         <glowOffset>2 2</glowOffset>
         <zIndex>82</zIndex>
      </text>

      <text name="libraryCaption" extra="static">
         <text>BIBLIOTECA DE JOGOS</text>
         <pos>0.790 0.037</pos>
         <size>0.180 0.026</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.017</fontSize>
         <color>B8C3D6FF</color>
         <alignment>right</alignment>
         <forceUppercase>true</forceUppercase>
         <zIndex>82</zIndex>
      </text>

      <image name="headerLine" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.028 0.095</pos>
         <size>0.944 0.002</size>
         <color>52627A70</color>
         <zIndex>79</zIndex>
      </image>

      <!-- Aura externa e painel em degrade para dar profundidade ao carrossel. -->
      <image name="carouselOuterGlow" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.021 0.108</pos>
         <size>0.958 0.300</size>
         <color>18D9FF70</color>
         <colorEnd>8B5CF670</colorEnd>
         <gradientType>horizontal</gradientType>
         <roundCorners>0.018</roundCorners>
         <zIndex>9</zIndex>
      </image>

      <image name="carouselPanel" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.025 0.112</pos>
         <size>0.950 0.292</size>
         <color>07111FF8</color>
         <colorEnd>151027F8</colorEnd>
         <gradientType>horizontal</gradientType>
         <roundCorners>0.015</roundCorners>
         <zIndex>10</zIndex>
      </image>

      <text name="carouselCaption" extra="static">
         <text>JOGOS DISPONIVEIS // BOX3D</text>
         <pos>0.043 0.123</pos>
         <size>0.310 0.024</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.017</fontSize>
         <color>EAF8FFFF</color>
         <forceUppercase>true</forceUppercase>
         <zIndex>76</zIndex>
      </text>

      <text name="carouselStatus" extra="static">
         <text>CAPAS 3D  |  SELECAO DINAMICA</text>
         <pos>0.680 0.123</pos>
         <size>0.275 0.024</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Roman.ttf</fontPath>
         <fontSize>0.014</fontSize>
         <color>93A9C5FF</color>
         <alignment>right</alignment>
         <forceUppercase>true</forceUppercase>
         <zIndex>76</zIndex>
      </text>

      <image name="carouselCaptionLine" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.043 0.151</pos>
         <size>0.914 0.002</size>
         <color>18D9FFFF</color>
         <colorEnd>8B5CF6FF</colorEnd>
         <gradientType>horizontal</gradientType>
         <zIndex>76</zIndex>
      </image>

      <!-- Feixe luminoso suave percorre a linha superior. -->
      <image name="carouselScanBeam" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.043 0.149</pos>
         <size>0.120 0.006</size>
         <color>FFFFFFFF</color>
         <colorEnd>18D9FF00</colorEnd>
         <gradientType>horizontal</gradientType>
         <roundCorners>0.004</roundCorners>
         <zIndex>77</zIndex>
         <storyboard repeat="forever">
            <animation property="x"
                       from="0.043"
                       to="0.837"
                       duration="2800"
                       mode="easeInOut" />
         </storyboard>
      </image>

      <!-- Oito capas da pasta atualmente aberta. -->
      <gamecarousel name="gamecarousel">
         <type>horizontal</type>
         <pos>0.040 0.160</pos>
         <size>0.920 0.228</size>
         <logoSize>0.095 0.94</logoSize>
         <logoScale>1.00</logoScale>
         <scaledLogoSpacing>1.06</scaledLogoSpacing>
         <maxLogoCount>8</maxLogoCount>
         <logoAlignment>center</logoAlignment>
         <minLogoOpacity>0.46</minLogoOpacity>
         <transitionSpeed>260</transitionSpeed>
         <imageSource>boxart</imageSource>
         <color>00000000</color>
         <zIndex>70</zIndex>

         <itemTemplate>
            <container>
               <scaleOrigin>0.5 0.5</scaleOrigin>

               <!-- Aura difusa: aparece apenas no jogo selecionado. -->
               <image name="cellAura"
                      pos="0.5 0.48"
                      origin="0.5 0.5"
                      size="0.82 0.72">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>18D9FF00</color>
                  <colorEnd>8B5CF600</colorEnd>
                  <gradientType>horizontal</gradientType>
                  <roundCorners>0.50</roundCorners>
                  <zIndex>0</zIndex>
                  <storyboard event="activate" repeat="forever">
                     <animation property="color"
                                from="18D9FF20"
                                to="18D9FF58"
                                duration="1050"
                                mode="easeInOut"
                                autoreverse="true" />
                     <animation property="colorEnd"
                                from="8B5CF620"
                                to="8B5CF650"
                                duration="1050"
                                mode="easeInOut"
                                autoreverse="true" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="18D9FF00"
                                duration="150"
                                mode="easeOut" />
                     <animation property="colorEnd"
                                to="8B5CF600"
                                duration="150"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <!-- Vidro quase transparente, sem o antigo cartao pesado. -->
               <image name="cellGlass"
                      pos="0.5 0.49"
                      origin="0.5 0.5"
                      size="0.72 0.88">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>07111F38</color>
                  <colorEnd>1B102D28</colorEnd>
                  <gradientType>vertical</gradientType>
                  <roundCorners>0.065</roundCorners>
                  <zIndex>1</zIndex>
                  <storyboard event="activate">
                     <animation property="color"
                                to="0A21365A"
                                duration="180"
                                mode="easeOut" />
                     <animation property="colorEnd"
                                to="2A164858"
                                duration="180"
                                mode="easeOut" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="07111F38"
                                duration="150"
                                mode="easeOut" />
                     <animation property="colorEnd"
                                to="1B102D28"
                                duration="150"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <!-- Trilhos laterais finos formam a moldura holografica. -->
               <image name="cellRailLeft"
                      pos="0.140 0.155"
                      size="0.012 0.615">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>18D9FF24</color>
                  <colorEnd>18D9FF00</colorEnd>
                  <gradientType>vertical</gradientType>
                  <roundCorners>0.008</roundCorners>
                  <zIndex>2</zIndex>
                  <storyboard event="activate">
                     <animation property="color"
                                to="18D9FFFF"
                                duration="180"
                                mode="easeOut" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="18D9FF24"
                                duration="140"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <image name="cellRailRight"
                      pos="0.848 0.155"
                      size="0.012 0.615">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>8B5CF624</color>
                  <colorEnd>8B5CF600</colorEnd>
                  <gradientType>vertical</gradientType>
                  <roundCorners>0.008</roundCorners>
                  <zIndex>2</zIndex>
                  <storyboard event="activate">
                     <animation property="color"
                                to="8B5CF6FF"
                                duration="180"
                                mode="easeOut" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="8B5CF624"
                                duration="140"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <!-- Cantos superiores abertos deixam a capa respirar. -->
               <image name="cellCornerTopLeft"
                      pos="0.140 0.155"
                      size="0.220 0.012">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>18D9FF28</color>
                  <colorEnd>18D9FF00</colorEnd>
                  <gradientType>horizontal</gradientType>
                  <roundCorners>0.008</roundCorners>
                  <zIndex>2</zIndex>
                  <storyboard event="activate">
                     <animation property="color"
                                to="18D9FFFF"
                                duration="180"
                                mode="easeOut" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="18D9FF28"
                                duration="140"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <image name="cellCornerTopRight"
                      pos="0.640 0.155"
                      size="0.220 0.012">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>8B5CF600</color>
                  <colorEnd>8B5CF628</colorEnd>
                  <gradientType>horizontal</gradientType>
                  <roundCorners>0.008</roundCorners>
                  <zIndex>2</zIndex>
                  <storyboard event="activate">
                     <animation property="colorEnd"
                                to="8B5CF6FF"
                                duration="180"
                                mode="easeOut" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="colorEnd"
                                to="8B5CF628"
                                duration="140"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <!-- Sombra eliptica cria a sensacao de capa flutuante. -->
               <image name="floatingShadow"
                      pos="0.5 0.895"
                      origin="0.5 0.5"
                      size="0.50 0.055">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>000000B8</color>
                  <colorEnd>00000000</colorEnd>
                  <gradientType>horizontal</gradientType>
                  <roundCorners>0.50</roundCorners>
                  <zIndex>3</zIndex>
               </image>

               <!-- Prioridade: media/box3d pelo nome da ROM; depois as midias do gamelist.xml. -->
               <image name="gameCover"
                      pos="0.5 0.49"
                      origin="0.5 0.5"
                      maxSize="0.78 0.82"
                      linearSmooth="true">
                  <path>firstfile(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png", {game:boxart}, {game:thumbnail}, {game:image}, {game:titleshot})</path>
                  <visible>exists(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png") || exists({game:boxart}) || exists({game:thumbnail}) || exists({game:image}) || exists({game:titleshot})</visible>
                  <saturation>0.76</saturation>
                  <zIndex>5</zIndex>
                  <storyboard event="activate">
                     <animation property="saturation"
                                to="1"
                                duration="200"
                                mode="easeOutCubic" />
                     <animation property="y"
                                to="0.465"
                                duration="200"
                                mode="easeOutCubic" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="saturation"
                                to="0.76"
                                duration="150"
                                mode="easeOut" />
                     <animation property="y"
                                to="0.49"
                                duration="150"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <!-- Pedestal luminoso acompanha o estado selecionado. -->
               <image name="cellPedestal"
                      pos="0.5 0.925"
                      origin="0.5 0.5"
                      size="0.62 0.014">
                  <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
                  <color>18D9FF30</color>
                  <colorEnd>8B5CF630</colorEnd>
                  <gradientType>horizontal</gradientType>
                  <roundCorners>0.008</roundCorners>
                  <zIndex>6</zIndex>
                  <storyboard event="activate" repeat="forever">
                     <animation property="color"
                                from="18D9FFB0"
                                to="18D9FFFF"
                                duration="820"
                                mode="easeInOut"
                                autoreverse="true" />
                     <animation property="colorEnd"
                                from="8B5CF6B0"
                                to="8B5CF6FF"
                                duration="820"
                                mode="easeInOut"
                                autoreverse="true" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="18D9FF30"
                                duration="140"
                                mode="easeOut" />
                     <animation property="colorEnd"
                                to="8B5CF630"
                                duration="140"
                                mode="easeOut" />
                  </storyboard>
               </image>

               <!-- Identificacao tecnica minimalista, visivel somente na selecao. -->
               <text name="cellTechnologyLabel"
                     pos="0.30 0.055"
                     size="0.40 0.080"
                     alignment="center"
                     verticalAlignment="center">
                  <text>BOX3D</text>
                  <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
                  <fontSize>0.013</fontSize>
                  <color>A9F3FF00</color>
                  <zIndex>7</zIndex>
                  <storyboard event="activate">
                     <animation property="color"
                                to="A9F3FFFF"
                                duration="220"
                                mode="easeOut" />
                  </storyboard>
                  <storyboard event="deactivate">
                     <animation property="color"
                                to="A9F3FF00"
                                duration="100"
                                mode="easeOut" />
                  </storyboard>
               </text>

               <!-- Nome organizado quando a capa nao existe. -->
               <text name="missingCoverName"
                     pos="0.16 0.18"
                     size="0.68 0.62"
                     alignment="center"
                     verticalAlignment="center"
                     multiLine="true">
                  <text>{game:name}</text>
                  <visible>!exists(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png") &amp;&amp; !exists({game:boxart}) &amp;&amp; !exists({game:thumbnail}) &amp;&amp; !exists({game:image}) &amp;&amp; !exists({game:titleshot})</visible>
                  <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
                  <fontSize>0.024</fontSize>
                  <lineSpacing>1.10</lineSpacing>
                  <color>E9EEF6FF</color>
                  <zIndex>8</zIndex>
               </text>

               <!-- Escala premium: destaque claro, sem exagero. -->
               <storyboard event="activate">
                  <animation property="scale"
                             to="1.13"
                             duration="200"
                             mode="easeOutCubic" />
               </storyboard>
               <storyboard event="deactivate">
                  <animation property="scale"
                             to="1"
                             duration="150"
                             mode="easeOutCubic" />
               </storyboard>
            </container>
         </itemTemplate>
      </gamecarousel>

      <!-- Compatibilidade com versoes que nao usam itemTemplate. -->
      <image name="gamecarouselLogo">
         <color>FFFFFFFF</color>
         <horizontalAlignment>center</horizontalAlignment>
         <verticalAlignment>center</verticalAlignment>
      </image>

      <text name="gamecarouselLogoText">
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.026</fontSize>
         <color>FFFFFFFF</color>
         <alignment>center</alignment>
         <verticalAlignment>center</verticalAlignment>
      </text>

      <!-- Painel de video com proporcao 16:9. -->
      <image name="videoPanel" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.025 0.423</pos>
         <size>0.515 0.510</size>
         <color>080C13F4</color>
         <roundCorners>0.015</roundCorners>
         <zIndex>10</zIndex>
      </image>

      <text name="videoCaption" extra="static">
         <text>VÍDEO / GAMEPLAY</text>
         <pos>0.045 0.438</pos>
         <size>0.250 0.025</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.017</fontSize>
         <color>DCE5F3FF</color>
         <forceUppercase>true</forceUppercase>
         <zIndex>44</zIndex>
      </text>

      <image name="videoAccent" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.045 0.468</pos>
         <size>0.475 0.002</size>
         <color>${genreColor}</color>
         <zIndex>44</zIndex>
      </image>

      <!-- Moldura para eliminar areas visuais soltas ao redor do video. -->
      <image name="videoFrame" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <origin>0.5 0.5</origin>
         <pos>0.2825 0.704</pos>
         <size>0.468 0.422</size>
         <color>000000FF</color>
         <roundCorners>0.012</roundCorners>
         <zIndex>18</zIndex>
      </image>

      <video name="md_video">
         <origin>0.5 0.5</origin>
         <pos>0.2825 0.704</pos>
         <maxSize>0.452 0.410</maxSize>
         <delay>${subset.video-gamelist-delay}</delay>
         <audio>${subset.videosnap-audio}</audio>
         <showSnapshotNoVideo>false</showSnapshotNoVideo>
         <showSnapshotDelay>true</showSnapshotDelay>
         <effect>none</effect>
         <loops>-1</loops>
         <visible>exists({game:video})</visible>
         <visible ifSubset="game-video:off">false</visible>
         <roundCorners>0.010</roundCorners>
         <zIndex>32</zIndex>
      </video>

      <!-- Capa ocupa o painel quando o jogo ainda nao possui video. -->
      <image name="selectedMediaFallback" extra="true">
         <path>firstfile(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png", {game:boxart}, {game:thumbnail}, {game:image}, {game:titleshot})</path>
         <origin>0.5 0.5</origin>
         <pos>0.2825 0.704</pos>
         <maxSize>0.300 0.410</maxSize>
         <visible>!exists({game:video}) &amp;&amp; (exists(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png") || exists({game:boxart}) || exists({game:thumbnail}) || exists({game:image}) || exists({game:titleshot}))</visible>
         <visible ifSubset="game-video:off">exists(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png") || exists({game:boxart}) || exists({game:thumbnail}) || exists({game:image}) || exists({game:titleshot})</visible>
         <linearSmooth>true</linearSmooth>
         <roundCorners>0.010</roundCorners>
         <zIndex>26</zIndex>
      </image>

      <text name="missingVideoMessage" extra="true">
         <text>VÍDEO NÃO DISPONÍVEL</text>
         <pos>0.095 0.690</pos>
         <size>0.375 0.035</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.022</fontSize>
         <color>8F9BAEFF</color>
         <alignment>center</alignment>
         <visible>!exists({game:video}) &amp;&amp; !exists(directory({game:path}) + "/media/box3d/" + {game:stem} + ".png") &amp;&amp; !exists({game:boxart}) &amp;&amp; !exists({game:thumbnail}) &amp;&amp; !exists({game:image}) &amp;&amp; !exists({game:titleshot})</visible>
         <zIndex>27</zIndex>
      </text>

      <!-- Painel lateral de informacoes. -->
      <image name="informationPanel" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.555 0.423</pos>
         <size>0.420 0.510</size>
         <color>0B111BEF</color>
         <roundCorners>0.015</roundCorners>
         <zIndex>10</zIndex>
      </image>

      <text name="informationCaption" extra="static">
         <text>INFORMAÇÕES DO JOGO</text>
         <pos>0.578 0.438</pos>
         <size>0.350 0.025</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.017</fontSize>
         <color>DCE5F3FF</color>
         <forceUppercase>true</forceUppercase>
         <zIndex>54</zIndex>
      </text>

      <image name="informationAccent" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.578 0.468</pos>
         <size>0.374 0.002</size>
         <color>${genreColor}</color>
         <zIndex>54</zIndex>
      </image>

      <text name="descriptionCaption" extra="static">
         <text>DESCRIÇÃO</text>
         <pos>0.578 0.487</pos>
         <size>0.150 0.023</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Bold.ttf</fontPath>
         <fontSize>0.015</fontSize>
         <color>8FA1B9FF</color>
         <forceUppercase>true</forceUppercase>
         <zIndex>54</zIndex>
      </text>

      <text name="md_description">
         <pos>0.578 0.516</pos>
         <size>0.374 0.180</size>
         <fontPath>${themePath}/_theme_inc/fonts/SST Light.ttf</fontPath>
         <fontSize>0.021</fontSize>
         <lineSpacing>1.16</lineSpacing>
         <color>ECF1F8FF</color>
         <verticalAlignment>top</verticalAlignment>
         <zIndex>54</zIndex>
      </text>

      <image name="metadataLine" extra="static">
         <path>${themePath}/_theme_inc/images/pixel-blanco.png</path>
         <pos>0.578 0.708</pos>
         <size>0.374 0.0015</size>
         <color>52627A70</color>
         <zIndex>54</zIndex>
      </image>

      <text name="developerLabel" extra="static">
         <text>DESENVOLVEDOR</text>
         <pos>0.578 0.728</pos>
         <size>0.120 0.029</size>
