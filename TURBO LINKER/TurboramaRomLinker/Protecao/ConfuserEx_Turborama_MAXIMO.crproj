<?xml version="1.0" encoding="utf-8"?>
<project baseDir="..\TurboramaRomLinker\bin\Release" outputDir="..\TurboramaRomLinker\bin\Release\Protegido_MAXIMO" xmlns="http://confuser.codeplex.com">
  <!-- Proteção PESADA para propriedade intelectual do Turborama ROM Linker.
       Use em Release. Teste em PC limpo antes de distribuir. -->
  <rule pattern="true" preset="none" inherit="false">
    <protection id="anti ildasm" />
    <protection id="anti tamper" />
    <protection id="constants">
      <argument name="mode" value="dynamic" />
      <argument name="decoderCount" value="16" />
    </protection>
    <protection id="ctrl flow">
      <argument name="intensity" value="100" />
      <argument name="depth" value="4" />
      <argument name="predicate" value="expression" />
    </protection>
    <protection id="ref proxy">
      <argument name="mode" value="strong" />
      <argument name="encoding" value="x86" />
    </protection>
    <protection id="resources">
      <argument name="mode" value="dynamic" />
    </protection>
    <protection id="rename">
      <argument name="mode" value="unicode" />
      <argument name="flatten" value="true" />
      <argument name="forceRen" value="true" />
      <argument name="renPublic" value="true" />
      <argument name="renPdb" value="true" />
    </protection>
  </rule>

  <!-- Anti-análise opcional. Se algum antivírus reclamar, use a versão NORMAL. -->
  <rule pattern="true" preset="none" inherit="true">
    <protection id="anti debug" />
    <protection id="anti dump" />
    <protection id="invalid metadata" />
  </rule>

  <module path="TurboramaRomLinker.exe" />
</project>
